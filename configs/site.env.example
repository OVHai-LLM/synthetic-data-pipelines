# Site configuration. Every script under scripts/ sources this.
#
#   cp configs/site.env.example configs/site.env   # gitignored; edit it for your cluster
#
# Scripts use configs/site.env when it exists, otherwise this example. Set
# SITE_ENV=/path/to/file to use another file. Each variable is set with
# `: "${VAR:=default}"`, so exporting it beforehand always wins.
#
# REPO_ROOT is resolved by the bootstrap block at the top of each script.

# ─── code ────────────────────────────────────────────────────────────────
: "${SRC_DIR:=$REPO_ROOT/src}"                    # holds math_generator/ and math_lean/

# ─── data ────────────────────────────────────────────────────────────────
: "${DATA_ROOT:=$REPO_ROOT/data}"
: "${ANNEAL_ROOT:=$DATA_ROOT}"                    # corpus tree: proofwiki_proofs.jsonl, postprocessed outputs
: "${WIKI_DUMP_ROOT:=$ANNEAL_ROOT/data}"          # Wikipedia dumps: <lang>/wikipedia-*/*.jsonl[.gz]
: "${SCRATCH_ROOT:=$DATA_ROOT/scratch}"          # large temporary files (merged seed shards, ...)
: "${AR_DATA_DIR:=$DATA_ROOT/active_reading}"    # raw Active Reading generations
: "${LOG_DIR:=$REPO_ROOT/logs}"

# ─── runtime ─────────────────────────────────────────────────────────────
# A venv containing vLLM. The SLURM scripts also run `module load ...` lines
# for the cluster the data was built on; edit or delete them for yours.
# Always `unset PYTHONPATH` after activating if your Python module ships
# bundled packages, or they will shadow the venv.
: "${VLLM_ENV:=$REPO_ROOT/.venv}"
: "${CACHE_ROOT:=$DATA_ROOT/cache}"              # HF / vLLM / triton / inductor caches (keep off $HOME)
: "${LEAN_TOOLCHAIN:=$DATA_ROOT/lean_toolchain}" # elan + a mathlib4 stub project (ProofWiki lean_check only)

# SLURM account/partition are not set in the .sbatch files; pass them at submit time:
#   sbatch -A <account> -p <gpu-partition> scripts/...
# or export SBATCH_ACCOUNT / SBATCH_PARTITION, which sbatch reads natively
# (child jobs submitted by the submit_*.sh helpers inherit them).

export SRC_DIR DATA_ROOT ANNEAL_ROOT WIKI_DUMP_ROOT SCRATCH_ROOT AR_DATA_DIR LOG_DIR \
       VLLM_ENV CACHE_ROOT LEAN_TOOLCHAIN
